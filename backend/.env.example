# Backend Environment Variables Example
# Copy this file to .env and change the values for production

# Database Configuration (MySQL)
MYSQL_USER=root
MYSQL_PASSWORD=1234
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=suspended_tech

# Security Keys (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=suspended-tech-secret-key-2026
JWT_SECRET=jwt-suspended-tech-2026

# Cloudinary (Replace with your actual URL from Cloudinary Dashboard)
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# Optional: Set the frontend URL for CORS (e.g. https://your-frontend.com)
# CORS_ORIGIN=*
